    <connection>oltp</connection>
    <sql>SELECT
  invoice_id
, branch
, city
, customer_type
, gender
, product_line
, unit_price
, quantity
, tax_five_percent
, sales
, STR_TO_DATE(Date, '%m/%d/%Y') as date_formatted
, Time
, payment
, cogs
, gross_margin_percentage
, gross_income
, rating
FROM oltp.supermarket_sales
WHERE DATE > ?
</sql>
